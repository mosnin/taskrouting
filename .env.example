# Database
DATABASE_URL="postgresql://taskrouting:taskrouting@localhost:5432/taskrouting?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Encryption key for integration credentials (32 bytes hex)
ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# GitHub OAuth (for user sign-in)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GitHub Integration (for workspace integration)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_APP_WEBHOOK_SECRET=""

# Slack Integration
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_SIGNING_SECRET=""

# Linear Integration
LINEAR_CLIENT_ID=""
LINEAR_CLIENT_SECRET=""
LINEAR_WEBHOOK_SECRET=""

# MCP Server
MCP_SERVER_PORT=3001
